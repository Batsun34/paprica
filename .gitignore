###############################################################################
# Java / Gradle
###############################################################################
*.class
*.log

# Gradle
.gradle/
build/
**/build/

# Gradle wrapper (обычно НУЖНО коммитить)
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# Gradle local config
gradle.properties

# Kotlin/Java annotation processing caches (на всякий)
kaptKotlin/
kapt/

###############################################################################
# Fabric / Loom / Minecraft dev runtime
###############################################################################
# Loom run директории
run/
runs/

# Часто создаются рядом или внутри run
logs/
crash-reports/

# Loom caches / remap outputs (обычно внутри .gradle, но оставим явно)
.remapped/
loom-cache/
.fabric/
fabric-cache/

###############################################################################
# Minecraft client files (если run/ не используется или кто-то запускает иначе)
###############################################################################
# Не хранить в репо реальные сохранения/ресурспаки/моды при тестах
saves/
resourcepacks/
shaderpacks/
mods/
config/
options.txt
optionsof.txt
servers.dat
usercache.json
usernamecache.json

# Скриншоты/записи
screenshots/
recordings/
replay_recordings/

###############################################################################
# Build artifacts / Releases
###############################################################################
# Готовые сборки модов (jar) обычно появляются в build/libs
*.jar
*.jar.original
*.zip
*.tar.gz

# Но если ты хочешь коммитить релизы в репо — убери строку "*.jar" выше
# и оставь игнор только для build/libs:
# build/libs/

###############################################################################
# Environment / Secrets
###############################################################################
.env
.env.*
!.env.example

# Локальные ключи/токены
*.keystore
*.jks
*.p12

###############################################################################
# Misc
###############################################################################
# Temporary files
*.tmp
*.swp
*.swo
*.bak

# Coverage / reports
coverage/
reports/
*.exec

